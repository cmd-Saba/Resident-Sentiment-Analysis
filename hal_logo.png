    <script>
      $(function () {
        $.getJSON("assets/js/demo-data/data.json", function (dataJSON) {
          $("#flowchat").flowchat({
            dataJSON: dataJSON,
            autoStart: false,
          });
        });
      });
    </script>

    <!-- flow chart ends here -->

    <script>
      $(document).ready(function () {
        var localstor_name = localStorage.getItem("bodybg");

        if (localstor_name == "black add") {
          $("body").addClass("color-theme");
          $(".colorbalck").removeClass("colorbalck").addClass("colrchange");
        }
        $("body").on("click", ".colorbalck", function (e) {
          {
            $(this).removeClass("colorbalck").addClass("colrchange");
            $("body").addClass("color-theme");
            localStorage.setItem("bodybg", "black add");
          }
        });
        $("body").on("click", ".colrchange", function (e) {
          {
            $(this).removeClass("colrchange").addClass("colorbalck");
            $("body").removeClass("color-theme");
            localStorage.setItem("bodybg", "black remove");
          }
        });
      });
    </script>
